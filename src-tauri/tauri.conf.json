{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "大宇宙播客",
  "mainBinaryName": "dear-universe-podcast",
  "version": "0.1.0",
  "identifier": "com.dearuniverse.podcast",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "大宇宙播客",
        "width": 1100,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/downloads/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0RjczRTY5Q0U0NUI0RjYKUldUMnRFWE9hVDczUk8xWWZ1TVFpVytvRW8wR1B5MTJzVnEyaVZGclZOM3hLNEhqbm1aRy8wdEcK",
      "endpoints": [
        "https://github.com/haha-anything/dear-universe-podcast/releases/latest/download/latest.json"
      ]
    }
  }
}
